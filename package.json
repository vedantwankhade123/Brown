{
  "name": "brown",
  "version": "1.0.2",
  "description": "Offline AI chat, code generation and visual answers for Windows (Brown)",
  "author": "Vedant Wankhade",
  "license": "Proprietary",
  "main": "src/main/index.js",
  "scripts": {
    "build:phone-preview": "node mobile/scripts/build-desktop-preview.cjs",
    "start": "electron .",
    "stop": "powershell -Command \"Stop-Process -Name electron -Force -ErrorAction SilentlyContinue\"",
    "build:win": "electron-builder --win nsis",
    "build:portable": "electron-builder --win portable",
    "build:store": "electron-builder --config electron-builder.store.cjs --win appx --x64 --publish never",
    "dist": "electron-builder --win",
    "dist:ci": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always",
    "release:desktop": "node scripts/release-desktop.js",
    "publish:desktop": "node scripts/release-desktop.js --publish",
    "test": "node tests/run.js"
  },
  "build": {
    "appId": "com.brown.desktop",
    "productName": "Brown AI",
    "copyright": "Copyright © 2026 Vedant Wankhade",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "vedantwankhade123",
      "repo": "Brown",
      "releaseType": "release"
    },
    "compression": "maximum",
    "npmRebuild": false,
    "electronLanguages": [
      "en-US"
    ],
    "asarUnpack": [
      "**/node_modules/onnxruntime-node/**",
      "**/*.node"
    ],
    "files": [
      "src/**/*",
      "scripts/**/*",
      "Assets/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/@huggingface/**/.cache{,/**}",
      "!node_modules/@xenova{,/**}",
      "!node_modules/**/types{,/**}",
      "!node_modules/**/*.map",
      "!node_modules/**/test{,/**}",
      "!node_modules/**/tests{,/**}",
      "!node_modules/**/__tests__{,/**}",
      "!node_modules/**/docs{,/**}",
      "!node_modules/**/examples{,/**}",
      "!node_modules/**/README*",
      "!node_modules/**/CHANGELOG*",
      "!node_modules/**/*.md",
      "!node_modules/onnxruntime-web{,/**}",
      "!node_modules/**/onnxruntime-web{,/**}",
      "!node_modules/**/.onnxruntime-node-*{,/**}",
      "!node_modules/onnxruntime-node/bin/napi-v3/darwin{,/**}",
      "!node_modules/onnxruntime-node/bin/napi-v3/linux{,/**}",
      "!node_modules/onnxruntime-node/bin/napi-v3/win32/arm64{,/**}",
      "!node_modules/**/onnxruntime-node/bin/napi-v3/darwin{,/**}",
      "!node_modules/**/onnxruntime-node/bin/napi-v3/linux{,/**}",
      "!node_modules/**/onnxruntime-node/bin/napi-v3/win32/arm64{,/**}",
      "!node_modules/mermaid/dist/mermaid.js",
      "!node_modules/mermaid/dist/chunks{,/**}",
      "!node_modules/mermaid/dist/*.map",
      "!node_modules/mermaid/dist/*.mjs",
      "!node_modules/mermaid/dist/*.d.ts",
      "!node_modules/kokoro-js/voices/!(af_heart|am_michael|bm_george|bm_lewis).bin"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "Assets/Brown.ico"
    },
    "portable": {
      "artifactName": "Brown AI v${version}.${ext}"
    },
    "appx": {
      "applicationId": "BrownAI",
      "identityName": "BinaryThings.BrownAI",
      "publisher": "CN=CE1F94E9-2491-422F-86EF-F824C694E0B6",
      "publisherDisplayName": "BinaryThings",
      "displayName": "Brown AI",
      "languages": [
        "en-US"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Brown AI",
      "uninstallDisplayName": "Brown AI",
      "installerIcon": "Assets/Brown.ico",
      "uninstallerIcon": "Assets/Brown.ico",
      "installerHeaderIcon": "Assets/Brand-Assets/Brown-header.ico",
      "installerSidebar": "Assets/installerSidebar.bmp",
      "uninstallerSidebar": "Assets/installerSidebar.bmp",
      "installerHeader": "Assets/installerHeader.bmp",
      "artifactName": "Brown AI Setup v${version}.${ext}",
      "runAfterFinish": true,
      "differentialPackage": false,
      "include": "build/installer.nsh"
    }
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.75",
    "@huggingface/transformers": "^3.8.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@modelcontextprotocol/server-filesystem": "^2026.7.10",
    "@mozilla/readability": "0.6.0",
    "ai": "^7.0.114",
    "dompurify": "^3.4.14",
    "electron-updater": "^6.3.9",
    "kokoro-js": "^1.2.1",
    "linkedom": "0.18.12",
    "lottie-web": "^5.13.0",
    "marked": "^18.0.6",
    "mcp-fetch-server": "^1.1.2",
    "mermaid": "^11.17.2",
    "onnxruntime-common": "1.21.0",
    "onnxruntime-node": "1.21.0",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "systeminformation": "^5.23.5",
    "turndown": "7.2.4",
    "ws": "^8.21.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "overrides": {
    "onnxruntime-common": "1.21.0"
  },
  "private": true
}
