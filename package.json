{
  "name": "brown",
  "version": "1.0.14",
  "description": "Local offline privacy-focused Windows AI Agent framework (Brown)",
  "author": "Vedant Wankhade",
  "license": "Proprietary",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "stop": "powershell -Command \"Stop-Process -Name electron -Force -ErrorAction SilentlyContinue\"",
    "build:win": "electron-builder --win nsis",
    "build:portable": "electron-builder --win portable",
    "build:store": "electron-builder --win appx",
    "dist": "electron-builder --win",
    "dist:ci": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always",
    "test": "node tests/run.js"
  },
  "build": {
    "appId": "com.brown.desktop",
    "productName": "Brown AI",
    "copyright": "Copyright © 2026 Vedant Wankhade",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "vedantwankhade123",
      "repo": "ultron-releases",
      "releaseType": "release"
    },
    "compression": "store",
    "npmRebuild": false,
    "electronLanguages": [
      "en-US"
    ],
    "asarUnpack": [
      "**/node_modules/onnxruntime-node/**",
      "**/*.node"
    ],
    "files": [
      "src/**/*",
      "scripts/**/*",
      "Assets/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/@huggingface/**/.cache{,/**}",
      "!node_modules/@xenova/**/.cache{,/**}",
      "!node_modules/**/types{,/**}",
      "!node_modules/**/*.map",
      "!node_modules/**/test{,/**}",
      "!node_modules/**/tests{,/**}",
      "!node_modules/**/__tests__{,/**}",
      "!node_modules/onnxruntime-web{,/**}",
      "!node_modules/**/onnxruntime-web{,/**}",
      "!node_modules/onnxruntime-node/bin/napi-v3/darwin{,/**}",
      "!node_modules/onnxruntime-node/bin/napi-v3/linux{,/**}",
      "!node_modules/onnxruntime-node/bin/napi-v3/win32/arm64{,/**}"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "Assets/Brand-Assets/brown-logo.ico",
      "certificateFile": null,
      "cscLink": null
    },
    "portable": {
      "artifactName": "Brown.AI.v${version}.${ext}"
    },
    "appx": {
      "applicationId": "BrownAI",
      "identityName": "YOUR_PUBLISHER_IDENTITY_NAME",
      "publisher": "CN=YOUR_PUBLISHER_ID_HERE",
      "publisherDisplayName": "Vedant Wankhade",
      "displayName": "Brown AI",
      "languages": [
        "en-US"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Brown AI",
      "uninstallDisplayName": "Brown AI",
      "installerIcon": "Assets/Brand-Assets/brown-logo.ico",
      "uninstallerIcon": "Assets/Brand-Assets/brown-logo.ico",
      "installerHeaderIcon": "Assets/Brand-Assets/brown-logo.ico",
      "installerSidebar": "Assets/installerSidebar.bmp",
      "uninstallerSidebar": "Assets/installerSidebar.bmp",
      "installerHeader": "Assets/installerHeader.bmp",
      "artifactName": "Brown.AI.Setup.v${version}.${ext}",
      "runAfterFinish": true,
      "differentialPackage": false,
      "include": "build/installer.nsh"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@modelcontextprotocol/server-filesystem": "^2026.7.10",
    "@xenova/transformers": "^2.17.2",
    "electron-updater": "^6.3.9",
    "kokoro-js": "^1.2.1",
    "marked": "^18.0.6",
    "mcp-fetch-server": "^1.1.2",
    "mermaid": "^11.17.2",
    "onnxruntime-common": "1.21.0",
    "onnxruntime-node": "1.21.0",
    "pdf-parse": "^2.4.5",
    "systeminformation": "^5.23.5",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "overrides": {
    "onnxruntime-common": "1.21.0"
  },
  "private": true
}
