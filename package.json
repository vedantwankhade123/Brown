{
  "name": "ultron",
  "version": "1.0.6",
  "description": "Local offline privacy-focused Windows AI Agent framework",
  "author": "Vedant Wankhade",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis",
    "build:portable": "electron-builder --win portable",
    "build:store": "electron-builder --win appx",
    "dist": "electron-builder --win",
    "test": "node tests/run.js"
  },
  "build": {
    "appId": "com.ultron.desktop",
    "productName": "Ultron AI",
    "copyright": "Copyright © 2026 Vedant Wankhade",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "vedantwankhade123",
      "repo": "Ultron",
      "releaseType": "prerelease"
    },
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "asarUnpack": [
      "**/node_modules/onnxruntime-node/**",
      "**/*.node"
    ],
    "files": [
      "src/**/*",
      "Assets/**/*",
      "package.json",
      "node_modules/@modelcontextprotocol/**/*",
      "node_modules/mcp-fetch-server/**/*",
      "node_modules/zod/**/*",
      "node_modules/eventsource/**/*",
      "node_modules/eventsource-parser/**/*",
      "node_modules/cross-spawn/**/*",
      "node_modules/which/**/*",
      "node_modules/path-key/**/*",
      "node_modules/shebang-command/**/*",
      "node_modules/shebang-regex/**/*",
      "node_modules/isexe/**/*",
      "node_modules/@xenova/**/*",
      "node_modules/kokoro-js/**/*",
      "node_modules/@huggingface/**/*",
      "node_modules/phonemizer/**/*",
      "node_modules/onnxruntime-node/**/*",
      "node_modules/onnxruntime-common/**/*",
      "node_modules/sharp/**/*",
      "node_modules/onnx-proto/**/*",
      "!node_modules/@huggingface/**/.cache{,/**}",
      "!node_modules/@xenova/**/.cache{,/**}",
      "!node_modules/**/types{,/**}",
      "!node_modules/**/*.map",
      "!node_modules/**/test{,/**}",
      "!node_modules/**/tests{,/**}",
      "!node_modules/**/__tests__{,/**}",
      "!node_modules/onnxruntime-web{,/**}",
      "!node_modules/**/onnxruntime-web{,/**}",
      "!node_modules/onnxruntime-node/bin/napi-v3/darwin{,/**}",
      "!node_modules/onnxruntime-node/bin/napi-v3/linux{,/**}",
      "!node_modules/onnxruntime-node/bin/napi-v3/win32/arm64{,/**}"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "Assets/ultron-logo.ico",
      "certificateFile": null,
      "cscLink": null
    },
    "appx": {
      "applicationId": "UltronAI",
      "identityName": "YOUR_PUBLISHER_IDENTITY_NAME",
      "publisher": "CN=YOUR_PUBLISHER_ID_HERE",
      "publisherDisplayName": "Vedant Wankhade",
      "displayName": "Ultron AI",
      "languages": [
        "en-US"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ultron AI",
      "uninstallDisplayName": "Ultron AI",
      "installerIcon": "Assets/ultron-logo.ico",
      "uninstallerIcon": "Assets/ultron-logo.ico",
      "installerHeaderIcon": "Assets/ultron-logo.ico",
      "artifactName": "${productName} Setup ${version}.${ext}",
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@modelcontextprotocol/server-filesystem": "^2026.7.10",
    "@xenova/transformers": "^2.17.2",
    "electron-updater": "^6.3.9",
    "kokoro-js": "^1.2.1",
    "marked": "^18.0.6",
    "mcp-fetch-server": "^1.1.2",
    "onnxruntime-common": "1.21.0",
    "onnxruntime-node": "1.21.0",
    "systeminformation": "^5.23.5",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "overrides": {
    "onnxruntime-common": "1.21.0"
  },
  "private": true
}
