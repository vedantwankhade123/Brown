# ==============================================================================
# Ultron Monorepo Git Exclusions (.gitignore)
# Covers: Windows Desktop App, Mobile App (Expo), Website (Firebase), & Python
# ==============================================================================

# OS & Workspace files
.DS_Store
Thumbs.db
*.tmp
*.bak
*.swp
*~

# Dependencies
node_modules/
.pnp
.pnp.js
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/

# Build & Release Artifacts
dist/
build/
web-build/
.expo/
.expo-shared/
*.exe
*.appx
*.msix
*.dmg
*.apk
*.aab
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local Development Runtimes & Caches (Models, Blobs, Manifests)
Ultron-local/
brown-local/
UltronDataDev-migrated-from-C/
"Downloadable Files"/
Downloadable Files/
.system_generated/
.gemini/
.agents/
.qoder/
.research/

# Secrets & Sensitive Keys
.env
.env.*
.env.local
.env.*.local
*.pem
*.key
*.cert
*.pfx
*.jks
*.keystore
secrets/

# Sibling project checkouts (separate repos)
brown-website/
brown-releases/
